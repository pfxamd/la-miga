---
import BaseLayout from '../layouts/BaseLayout.astro';
import AddToCart from '../components/cart/AddToCart';
import { products, categoryLabels, withBase } from '../data/products';

const base = import.meta.env.BASE_URL;
const featured = products[0];
---
<BaseLayout title="LA MIGA — Panadería Artesanal · Tetuán">
  <main>
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__copy">
          <span class="eyebrow eyebrow--accent"><span class="eyebrow__line"></span>PANADERÍA ARTESANAL · TETUÁN</span>
          <h1>EL PAN,<br /><em>COMO DEBE</em><br />SER.</h1>
          <p>Ingredientes sencillos, manos expertas y tiempo. Mucho tiempo. Así hacemos cada uno de nuestros panes.</p>
          <a class="primary-link" href="#panes">Descubre nuestros panes <span aria-hidden="true">↗</span></a>
          <div class="hero__meta"><span>01 / MASA MADRE</span><span>HORNEADO CADA DÍA</span></div>
        </div>
        <div class="hero__visual">
          <div class="hero__art" aria-hidden="true"><span>LA<br/>MIGA</span><span class="hero__circle"></span></div>
          <img class="hero__bread" src={withBase(featured.image)} width="512" height="512" alt="Pan de masa madre artesano con corteza dorada" fetchpriority="high" />
          <div class="hero__stamp"><strong>100%</strong><small>AMOR<br />POR EL PAN</small></div>
          <span class="hero__caption">Nº 01 · NUESTRO FAVORITO</span>
        </div>
      </div>
    </section>

    <div class="ticker" aria-label="Nuestros valores"><div class="ticker__inner" aria-hidden="true"><span>MASA MADRE</span><i>✳</i><span>HORNEADO CADA DÍA</span><i>✳</i><span>HECHO A MANO</span><i>✳</i><span>DESDE TETUÁN</span><i>✳</i></div></div>

    <section class="products-section section" id="panes">
      <div class="container">
        <div class="section-heading"><div><span class="eyebrow">RECIÉN SALIDOS DEL HORNO</span><h2>Nuestros <em>panes.</em></h2></div><p>Distintas formas, distintas historias.<br />Un mismo amor por el buen pan.</p></div>
        <div class="filters" role="group" aria-label="Filtrar panes">
          <button class="filter is-active" data-filter="todos" type="button" aria-pressed="true">Todos <span>{String(products.length).padStart(2,'0')}</span></button>
          {Object.entries(categoryLabels).map(([key, label]) => <button class="filter" data-filter={key} type="button" aria-pressed="false">{label}</button>)}
        </div>
        <div class="product-grid">
          {products.map((product, index) => (
            <article class="product-card" data-category={product.category}>
              <div class:list={['product-card__visual', `product-card__visual--${(index % 4) + 1}`]}>
                <span class="product-card__index">LM / {String(index + 1).padStart(2,'0')}</span>
                <a href={`${base}pan/${product.slug}/`} aria-label={`Ver ${product.name}`} class="product-card__image-link">
                  <img src={withBase(product.image)} width="512" height="512" alt={product.name} loading="lazy" decoding="async" />
                </a>
                <span class="product-card__weight">{product.weightGrams} g</span>
              </div>
              <div class="product-card__info">
                <div><a href={`${base}pan/${product.slug}/`} class="product-card__title">{product.name}</a><p>{product.subtitle}</p></div>
                <strong class="product-card__price">{product.priceMAD} <small>MAD</small></strong>
              </div>
              <div class="product-card__action"><AddToCart client:load id={product.id} title="Añadir a la cesta" /><a href={`${base}pan/${product.slug}/`} class="text-link">Ver detalles ↗</a></div>
            </article>
          ))}
        </div>
        <p class="catalog-footnote">Precios orientativos para esta demostración · Disponibilidad sujeta a confirmación.</p>
      </div>
    </section>

    <section class="process-section section" id="obrador">
      <div class="container">
        <div class="section-heading section-heading--light"><div><span class="eyebrow">DE LA HARINA AL HORNO</span><h2>El arte de <em>hacer pan.</em></h2></div><p>Nuestro obrador combina buenas herramientas, paciencia y las manos que dan forma a cada pieza.</p></div>
        <div class="process-grid">
          <div class="process-step"><span>01</span><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M22 86h116M41 78q8-41 39-41t39 41M29 91l9-10m93 10-9-10M49 54h62M60 67h40" /></svg><h3>El amasado</h3><p>Harina, agua y una mezcla precisa hasta conseguir la textura perfecta.</p></div>
          <div class="process-step"><span>02</span><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M23 86h114M36 72q9-35 44-35t44 35M42 72q39 18 76 0M80 24v-9m-18 13-7-8m43 8 7-8" /></svg><h3>La fermentación</h3><p>El tiempo hace lo suyo y convierte una masa sencilla en algo especial.</p></div>
          <div class="process-step"><span>03</span><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M28 83q17-35 52-35t52 35q-52 19-104 0ZM51 72l16-15m-1 21 17-20m-1 24 16-20" /></svg><h3>El formado</h3><p>Cada pieza toma forma antes de recibir su corte característico.</p></div>
          <div class="process-step"><span>04</span><svg viewBox="0 0 160 115" aria-hidden="true"><path d="M24 92V52q1-32 56-32t56 32v40ZM39 92V59q1-23 41-23t41 23v33M40 92h80M55 80q-3-16 7-23m18 23q-5-16 6-25m17 25q-3-16 7-23" /></svg><h3>El horneado</h3><p>Calor, corteza dorada y ese aroma que anuncia que el pan está listo.</p></div>
        </div>
      </div>
    </section>

    <section class="story-section section" id="nosotros">
      <div class="container story-section__inner">
        <div class="story-section__badge" aria-hidden="true"><span>LA MIGA</span><div>✳</div><small>DESDE TETUÁN · CON AMOR</small></div>
        <div class="story-section__text"><span class="eyebrow">UN OBRADOR, UNA IDEA</span><h2>Hacer las cosas <em>bien.</em> Sin prisa.</h2><p>Creemos en el buen pan de cada día. En el cuidado de los ingredientes, el respeto por los procesos y el placer de llevar algo recién hecho a la mesa.</p><a class="primary-link primary-link--dark" href="#panes">Elige tu pan <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
  </main>
  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const value = button.dataset.filter;
        for (const item of buttons) {
          const selected = item === button;
          item.classList.toggle('is-active', selected);
          item.setAttribute('aria-pressed', String(selected));
        }
        for (const card of cards) card.hidden = value !== 'todos' && card.dataset.category !== value;
      });
    }
  </script>
</BaseLayout>
