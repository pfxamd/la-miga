---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddToCart from '../../components/cart/AddToCart';
import { categoryLabels, products, withBase, siteBase } from '../../data/products';
import type { BreadProduct } from '../../data/products';

export const getStaticPaths = (() => products.map((product) => ({
  params: { slug: product.slug },
  props: { product },
}))) satisfies GetStaticPaths;

const { product } = Astro.props as { product: BreadProduct };
const base = siteBase;
---
<BaseLayout title={`${product.name} — LA MIGA`} description={product.description}>
  <main class="detail-page container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href={base}>Inicio</a><span aria-hidden="true">/</span><a href={`${base}#panes`}>Nuestros panes</a><span aria-hidden="true">/</span><span>{product.name}</span></nav>
    <div class="detail-layout">
      <div class="detail-visual"><span class="eyebrow">{categoryLabels[product.category]} · {product.weightGrams} G</span><a href={withBase(product.image)} class="detail-visual__image" data-pswp-width="512" data-pswp-height="512" aria-label={`Ampliar imagen de ${product.name}`}><img src={withBase(product.image)} width="512" height="512" alt={product.name} decoding="async"/></a><span class="detail-visual__note">HAZ CLIC PARA AMPLIAR ↗</span></div>
      <div class="detail-copy"><span class="eyebrow eyebrow--accent">PAN HECHO CON TIEMPO</span><h1>{product.name}<span>.</span></h1><p class="detail-subtitle">{product.subtitle}</p><p class="detail-description">{product.description}</p><dl class="detail-facts"><div><dt>Peso</dt><dd>{product.weightGrams} g</dd></div><div><dt>Ingredientes</dt><dd>{product.ingredients}</dd></div><div><dt>Disponibilidad</dt><dd>{product.available ? 'Bajo confirmación' : 'Temporalmente agotado'}</dd></div></dl><div class="detail-buy"><strong>{product.priceMAD} <small>MAD</small></strong><AddToCart client:load id={product.id} title="Añadir a la cesta" full /></div><p class="detail-note">Precio orientativo. Recogida previa confirmación por WhatsApp.</p></div>
    </div>
    <div class="detail-return"><a href={`${base}#panes`}>← Volver a todos los panes</a></div>
  </main>
  <script>
    import { mountLightbox } from '../../lib/lightbox';
    const gallery = document.querySelector('.detail-visual');
    if (gallery) {
      mountLightbox('.detail-visual').then((destroy) => {
        document.addEventListener('astro:before-swap', destroy, { once: true });
      }).catch(() => {});
    }
  </script>
</BaseLayout>
