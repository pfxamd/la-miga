---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteBase, withBase } from '../../data/products';

const tools = [
  { id:'01', category:'AMASADO', name:'La amasadora', text:'La harina y el agua se convierten en una masa con textura y fuerza.', image:'amasadora', w:502, h:331, alt:'Amasadora profesional de acero inoxidable mezclando masa de pan.' },
  { id:'02', category:'FERMENTACIÓN', name:'Las cestas', text:'La masa reposa sobre lino y mimbre, conservando su forma antes de pasar al horno.', image:'fermentacion', w:510, h:331, alt:'Masa de pan fermentando dentro de una cesta de mimbre forrada de lino.' },
  { id:'03', category:'EL FORMADO', name:'El banco de trabajo', text:'Rasqueta, cuchilla y harina: las herramientas de los detalles que importan.', image:'banco', w:499, h:331, alt:'Rasqueta y cuchilla de panadería junto a una pieza de masa sobre una mesa de madera.' },
];
const moments = [
  { id:'04', category:'EL CORTE', name:'La última marca.', text:'Un corte preciso guía la forma de la corteza durante la cocción.', image:'formado', w:762, h:331, alt:'Primer plano de manos sin rostro trazando cortes sobre una hogaza de masa cruda.' },
  { id:'05', category:'EL HORNO', name:'El momento esperado.', text:'Del horno sale una corteza dorada, crujiente, lista para compartir.', image:'horno', w:761, h:331, alt:'Panes artesanales dorados sobre una pala junto a un horno encendido.' },
];
---
<BaseLayout title="El obrador — LA MIGA" description="Un recorrido visual por el obrador: amasado, fermentación, formado y horneado." active="obrador">
  <main class="obrador-gallery">
    <header class="inner-intro inner-intro--workshop obrador-intro">
      <div class="container inner-intro__grid">
        <div>
          <span class="eyebrow inner-intro__eyebrow">LA MIGA / DENTRO DEL OBRADOR</span>
          <h1>Donde empieza <em>todo.</em></h1>
          <p>Harina, agua, buenas herramientas y tiempo. Cada pieza nace de un proceso cuidado.</p>
        </div>
        <div class="inner-intro__aside">
          <span class="inner-intro__number">06</span>
          <span>ESCENAS DEL<br />OBRADOR</span>
        </div>
      </div>
    </header>

    <section class="obrador-panorama-section" aria-label="Vista del obrador">
      <div class="container">
        <figure class="obrador-panorama">
          <a href={withBase('assets/obrador/hero.webp')} data-pswp-width="1530" data-pswp-height="333" aria-label="Ampliar la vista del obrador">
            <img src={withBase('assets/obrador/hero.webp')} width="1530" height="333" decoding="async" fetchpriority="high" alt="Interior de una panadería con mesas de trabajo, cestas de fermentación, panes y horno profesional." />
          </a>
          <figcaption><span>00 / EL ESPACIO</span><strong>Hecho con tiempo.</strong></figcaption>
        </figure>
      </div>
    </section>

    <section class="section obrador-equipment" aria-labelledby="equipment-title">
      <div class="container">
        <div class="section-heading">
          <div><span class="eyebrow">LAS HERRAMIENTAS DEL OFICIO</span><h2 id="equipment-title">El trabajo <em>empieza aquí.</em></h2></div>
          <p>Acero, madera, lino y harina. Materiales que acompañan cada etapa de nuestro pan.</p>
        </div>
        <div class="obrador-equipment__grid">
          {tools.map((item) => (
            <article class="obrador-equipment__item">
              <div class="obrador-photo-meta"><span>LM / {item.id}</span><span>{item.category}</span></div>
              <a class="obrador-photo" href={withBase(`assets/obrador/${item.image}.webp`)} data-pswp-width={String(item.w)} data-pswp-height={String(item.h)} aria-label={`Ampliar: ${item.name}`}>
                <img src={withBase(`assets/obrador/${item.image}.webp`)} width={item.w} height={item.h} alt={item.alt} loading="lazy" decoding="async" />
                <span aria-hidden="true">↗</span>
              </a>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section obrador-moments" aria-labelledby="moments-title">
      <div class="container">
        <div class="section-heading section-heading--light">
          <div><span class="eyebrow">DE LAS MANOS AL HORNO</span><h2 id="moments-title">La última <em>transformación.</em></h2></div>
          <p>Dar forma, cortar y hornear. Cada gesto deja su huella en el pan.</p>
        </div>
        <div class="obrador-moments__grid">
          {moments.map((item) => (
            <figure class="obrador-moments__item">
              <a class="obrador-photo" href={withBase(`assets/obrador/${item.image}.webp`)} data-pswp-width={String(item.w)} data-pswp-height={String(item.h)} aria-label={`Ampliar: ${item.name}`}>
                <img src={withBase(`assets/obrador/${item.image}.webp`)} width={item.w} height={item.h} alt={item.alt} loading="lazy" decoding="async" />
                <span aria-hidden="true">↗</span>
              </a>
              <figcaption><span class="obrador-moments__meta">LM / {item.id} — {item.category}</span><h3>{item.name}</h3><p>{item.text}</p></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
    <section class="section workshop-outro">
      <div class="container workshop-outro__inner">
        <span class="eyebrow">DEL OBRADOR A TU MESA</span>
        <h2>Todo esto, para <em>una buena miga.</em></h2>
        <a class="editorial-link" href={`${siteBase}panes/`}>Conoce nuestros panes <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <script>
    import { mountLightbox } from '../../lib/lightbox';
    mountLightbox('.obrador-gallery').catch(() => {
      // Fallback: image links can still open normally.
    });
  </script>
</BaseLayout>
