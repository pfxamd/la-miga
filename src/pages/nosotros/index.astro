---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteBase, withBase } from '../../data/products';

const values = [
  {
    number: '01', label: 'SENCILLEZ',
    title: 'Ingredientes claros',
    text: 'Harina, agua y lo necesario para que cada variedad sepa a buen pan.',
    image: 'trigo', width: 472, height: 279,
    alt: 'Espigas maduras de trigo dorado iluminadas por el sol.',
  },
  {
    number: '02', label: 'OFICIO',
    title: 'Cuidar el proceso',
    text: 'Cada gesto tiene su momento, desde la mezcla hasta la última fermentación.',
    image: 'harina', width: 435, height: 316,
    alt: 'Pala metálica hundida en harina sobre una mesa de panadería.',
  },
  {
    number: '03', label: 'CERCANÍA',
    title: 'Desde Tetuán',
    text: 'Una panadería de barrio que quiere hacer del buen pan algo cotidiano.',
    image: 'obrador', width: 607, height: 318,
    alt: 'Pequeño obrador de estilo artesanal con estantes y panes recién horneados.',
  },
];
---
<BaseLayout
  title="Nuestra historia — LA MIGA"
  description="La idea detrás de LA MIGA: una pequeña panadería artesanal de Tetuán especializada en el pan."
  active="nosotros"
>
  <main class="nosotros-gallery">
    <header class="inner-intro inner-intro--story">
      <div class="container inner-intro__grid">
        <div>
          <span class="eyebrow inner-intro__eyebrow">LA MIGA / NUESTRA HISTORIA</span>
          <h1>Una idea <em>muy sencilla.</em></h1>
          <p>Hacer pan del que apetece partir un trozo antes de llegar a casa.</p>
        </div>
        <figure class="story-intro__photo">
          <a href={withBase('assets/nosotros/fachada.webp')} data-pswp-width="874" data-pswp-height="402" aria-label="Ampliar imagen de la fachada conceptual de LA MIGA">
            <img
              src={withBase('assets/nosotros/fachada.webp')}
              width="874" height="402"
              alt="Interpretación visual de la fachada de LA MIGA con un rótulo de panadería artesanal."
              fetchpriority="high" decoding="async"
            />
          </a>
          <figcaption>UNA PANADERÍA CON IDENTIDAD</figcaption>
        </figure>
      </div>
    </header>

    <section class="section about-story" aria-labelledby="about-title">
      <div class="container about-story__grid">
        <div class="about-story__visual">
          <a class="about-story__photo" href={withBase('assets/nosotros/hogaza.webp')} data-pswp-width="650" data-pswp-height="402" aria-label="Ampliar imagen de la hogaza de pan">
            <img src={withBase('assets/nosotros/hogaza.webp')} width="650" height="402"
              loading="lazy" decoding="async"
              alt="Hogaza artesanal con corteza de harina y greñado, sobre un paño natural." />
          </a>
          <span class="eyebrow">EL PAN COMO PROTAGONISTA</span>
          <span class="about-story__note">HARINA · AGUA · TIEMPO</span>
        </div>
        <div class="about-story__copy">
          <span class="eyebrow">LO QUE NOS MUEVE</span>
          <h2 id="about-title">No buscamos hacer de todo. <em>Solo buen pan.</em></h2>
          <p>LA MIGA nace de una idea personal: abrir una panadería donde el pan vuelva a tener todo el protagonismo. Sin vitrinas interminables ni distracciones. Solo variedades bien escogidas.</p>
          <p>Nos gustan las formas que cuentan algo de su origen: una barra alargada, un pan de miga firme, un mollete suave. Cada uno tiene su lugar en la mesa.</p>
          <a class="editorial-link" href={`${siteBase}panes/`}>Descubre la colección <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="about-crumb" aria-labelledby="crumb-title">
      <div class="container about-crumb__grid">
        <a class="about-crumb__photo" href={withBase('assets/nosotros/miga.webp')} data-pswp-width="802" data-pswp-height="283" aria-label="Ampliar detalle de la miga del pan">
          <img src={withBase('assets/nosotros/miga.webp')} width="802" height="283"
            loading="lazy" decoding="async"
            alt="Miga aireada de una hogaza cortada, con corteza dorada y textura natural." />
        </a>
        <div class="about-crumb__caption">
          <span class="eyebrow">EL DETALLE</span>
          <h2 id="crumb-title">Todo está en <em>la miga.</em></h2>
          <p>La corteza cuenta una parte de la historia. El interior cuenta el resto.</p>
        </div>
      </div>
    </section>

    <section class="section values-section" aria-labelledby="values-title">
      <div class="container">
        <div class="section-heading">
          <div><span class="eyebrow">NUESTROS PRINCIPIOS</span><h2 id="values-title">Menos ruido. <em>Más pan.</em></h2></div>
        </div>
        <div class="values-grid">
          {values.map((value) => (
            <article>
              <a class="value-photo" href={withBase(`assets/nosotros/${value.image}.webp`)}
                data-pswp-width={String(value.width)} data-pswp-height={String(value.height)}
                aria-label={`Ampliar imagen: ${value.title}`}>
                <img src={withBase(`assets/nosotros/${value.image}.webp`)}
                  width={value.width} height={value.height}
                  loading="lazy" decoding="async" alt={value.alt} />
                <span aria-hidden="true">↗</span>
              </a>
              <span>{value.label}</span>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-story__end">
      <div class="container">
        <p>Una hogaza. Una barra. Una buena historia.</p>
        <a href={`${siteBase}obrador/`} class="editorial-link editorial-link--light">Descubre nuestro obrador <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <script>
    import { mountLightbox } from '../../lib/lightbox';
    mountLightbox('.nosotros-gallery').catch(() => {
      // Keep ordinary image links available if the lightbox cannot load.
    });
  </script>
</BaseLayout>
