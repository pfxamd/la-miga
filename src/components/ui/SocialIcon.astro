---
interface Props {
  name: 'instagram' | 'facebook' | 'tiktok' | 'whatsapp' | 'mail' | 'phone' | 'pin' | 'arrow';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg class="social-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.65" />
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.65" />
      <circle cx="17.55" cy="6.7" r="1" fill="currentColor" />
    </>
  )}
  {name === 'facebook' && (
    <path d="M14.45 21v-7.8h2.6l.4-3.3h-3V7.8c0-.95.28-1.6 1.62-1.6h1.55V3.25a20.6 20.6 0 0 0-2.28-.13C12.75 3.12 11 4.65 11 7.47V9.9H8.4v3.3H11V21h3.45Z" fill="currentColor" />
  )}
  {name === 'tiktok' && (
    <path d="M14.2 3c.17 2.55 1.42 4.03 4.3 4.2v3.28a8.36 8.36 0 0 1-4.3-1.25v5.72a5.02 5.02 0 1 1-5.03-5.05c.32 0 .65.03.97.09v3.37a1.79 1.79 0 1 0 .62 1.59V3h3.44Z" fill="currentColor" />
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M20.7 11.76a8.65 8.65 0 0 1-12.68 7.65L3.3 20.7l1.32-4.53A8.65 8.65 0 1 1 20.7 11.76Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round" />
      <path d="M8.33 8.1c-.38.15-.9.72-.91 1.55-.02 1.52 1.48 3.25 2.95 4.43 1.12.9 2.52 1.51 3.56 1.44.62-.03 1.38-.54 1.57-1.15l.16-.68-2.17-1.07-.96 1.1c-1.34-.6-2.21-1.5-2.87-2.87l1.02-.96-1.06-2.13-1.29.04Z" fill="currentColor"/>
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="2.75" y="5.5" width="18.5" height="13" rx="1.5" stroke="currentColor" stroke-width="1.5" />
      <path d="m3.5 6.5 8.5 6.75 8.5-6.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </>
  )}
  {name === 'phone' && (
    <path d="M7.4 3.6 10.3 6.4 8.8 9.2c1.28 2.69 3.22 4.63 5.98 5.96l2.77-1.54 2.9 2.85-1.48 3.01c-.38.83-1.45 1.2-2.35 1.06C9.55 19.3 4.68 14.38 3.6 7.34 3.46 6.4 3.8 5.43 4.65 5.02L7.4 3.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
  )}
  {name === 'pin' && (
    <>
      <path d="M19 10c0 5.1-7 11-7 11S5 15.1 5 10a7 7 0 1 1 14 0Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
    </>
  )}
  {name === 'arrow' && (
    <path d="M5 18 18 5M8.5 5H18v9.5" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
  )}
</svg>
