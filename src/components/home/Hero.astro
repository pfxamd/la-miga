---
import { products, withBase, siteBase } from '../../data/products';
import HeroEngraving from './HeroEngraving.astro';
const featured = products[0];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <svg class="hero__thread" viewBox="0 0 1200 530" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
      <g stroke="currentColor" stroke-linecap="round">
        <path d="M360 472C449 459 495 418 564 349C651 261 710 235 818 239" />
        <path d="M381 490C466 472 526 427 596 364C685 287 739 270 831 273" />
        <path d="M422 508C511 477 556 445 626 391C712 326 767 308 857 307" />
      </g>
      <g class="hero__thread-ticks" stroke="currentColor">
        <path d="M570 334l9 22M603 354l9 22M635 377l9 22"/>
        <circle cx="818" cy="239" r="4"/><circle cx="857" cy="307" r="3"/>
      </g>
    </svg>

    <div class="hero__copy">
      <div class="hero__eyebrow">
        <span class="hero__eyebrow-index">LM / 001</span>
        <span>PANADERÍA ARTESANAL · TETUÁN</span>
      </div>
      <h1 id="hero-title">
        <span class="hero__title-lead">Pan <span>de</span></span>
        <em class="hero__title-finish">verdad<span class="hero__full-stop">.</span></em>
      </h1>
      <p>Harina, agua, sal y tiempo. Seis panes con carácter para volver a disfrutar de lo sencillo.</p>
      <a class="primary-link" href={`${siteBase}panes/`}>
        <span>Descubre nuestros panes</span>
        <svg width="19" height="19" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <div class="hero__meta">
        <span>01 / 06 · PANES ARTESANOS</span>
        <span>HECHO EN TETUÁN</span>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__art" aria-hidden="true">
        <HeroEngraving />
      </div>
      <div class="hero__bread-stage" role="img" aria-label={`Pan artesanal: ${featured.name}`}>
        <img class="hero__bread-layer hero__bread-layer--shadow" src={withBase('assets/hero-layers/base-shadow.webp')} width="800" height="800" alt="" aria-hidden="true" decoding="async" />
        <img class="hero__bread-layer hero__bread-layer--body" src={withBase('assets/hero-layers/bread-body.webp')} width="800" height="800" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
        <img class="hero__bread-layer hero__bread-layer--score" src={withBase('assets/hero-layers/score-main.webp')} width="800" height="800" alt="" aria-hidden="true" decoding="async" />
        <img class="hero__bread-layer hero__bread-layer--flour" src={withBase('assets/hero-layers/flour-surface.webp')} width="800" height="800" alt="" aria-hidden="true" decoding="async" />
        <img class="hero__bread-layer hero__bread-layer--dust" src={withBase('assets/hero-layers/flour-particles.webp')} width="800" height="800" alt="" aria-hidden="true" decoding="async" />
      </div>
      <span class="hero__visual-index" aria-hidden="true">FIG. 01 — LA MIGA</span>
      <div class="hero__product-label" aria-hidden="true">
        <span class="hero__product-number">NUESTRA SELECCIÓN / 01</span>
        <span class="hero__product-title">{featured.name}</span>
      </div>
    </div>
  </div>
</section>
<div class="ticker" aria-label="Nuestros valores">
  <div class="ticker__inner">
    <span>HARINA &amp; AGUA</span><i aria-hidden="true">✳</i>
    <span>TIEMPO &amp; PACIENCIA</span><i aria-hidden="true">✳</i>
    <span>PAN DE VERDAD</span><i aria-hidden="true">✳</i>
    <span>DESDE TETUÁN</span>
  </div>
</div>

<script>
  // The real bread photograph is split into registered, transparent layers.
  // No scroll interception: native wheel and touch motion remain untouched.
  const hero = document.querySelector<HTMLElement>('.hero');
  const stage = document.querySelector<HTMLElement>('.hero__bread-stage');
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (hero && stage && !motionPreference.matches) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const offset = hero.getBoundingClientRect().top + window.scrollY;
      const distance = Math.max(260, hero.offsetHeight * .64);
      const t = Math.max(0, Math.min(1, (window.scrollY - offset) / distance));
      // Photo masks stay registered; only soft detail and independent dust move.
      stage.style.setProperty('--bread-flour-opacity', String(Math.min(1, Math.max(0, (t - .1) / .72))));
      stage.style.setProperty('--bread-score-opacity', String(.18 + t * .6));
      stage.style.setProperty('--bread-dust-opacity', String(Math.min(.77, t * .95)));
      stage.style.setProperty('--bread-dust-x', `${t * 17}px`);
      stage.style.setProperty('--bread-dust-y', `${-t * 14}px`);
      stage.style.setProperty('--bread-flour-y', `${(1 - t) * -2}px`);
    };
    const schedule = () => {
      if (raf) return;
      raf = window.requestAnimationFrame(update);
    };
    schedule();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  }
</script>
