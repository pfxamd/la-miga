---
import { products, withBase, siteBase } from '../../data/products';
import HeroEngraving from './HeroEngraving.astro';
const featured = products[0];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <svg class="hero__thread" viewBox="0 0 1200 530" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
      <g stroke="currentColor" stroke-linecap="round">
        <path d="M360 472C449 459 495 418 564 349C651 261 710 235 818 239" />
        <path d="M381 490C466 472 526 427 596 364C685 287 739 270 831 273" />
        <path d="M422 508C511 477 556 445 626 391C712 326 767 308 857 307" />
      </g>
      <g class="hero__thread-ticks" stroke="currentColor">
        <path d="M570 334l9 22M603 354l9 22M635 377l9 22"/>
        <circle cx="818" cy="239" r="4"/><circle cx="857" cy="307" r="3"/>
      </g>
    </svg>

    <div class="hero__copy">
      <div class="hero__eyebrow">
        <span class="hero__eyebrow-index">LM / 001</span>
        <span>PANADERÍA ARTESANAL · TETUÁN</span>
      </div>
      <h1 id="hero-title">
        <span class="hero__title-lead">Pan <span>de</span></span>
        <em class="hero__title-finish">verdad<span class="hero__full-stop">.</span></em>
      </h1>
      <p>Harina, agua, sal y tiempo. Seis panes con carácter para volver a disfrutar de lo sencillo.</p>
      <a class="primary-link" href={`${siteBase}panes/`}>
        <span>Descubre nuestros panes</span>
        <svg width="19" height="19" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <div class="hero__meta">
        <span>01 / 06 · PANES ARTESANOS</span>
        <span>HECHO EN TETUÁN</span>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__art" aria-hidden="true">
        <HeroEngraving />
      </div>
      <div class="hero__bread-stage" role="img" aria-label={`Pan artesanal: ${featured.name}`}>
        <img class="hero__bread-layer hero__bread-layer--shadow" src={withBase('assets/hero-layers/base-shadow.webp')} width="800" height="800" alt="" aria-hidden="true" decoding="async" />
        <div class="hero__bread-object" aria-hidden="true">
          <img class="hero__bread-layer hero__bread-layer--body" src={withBase('assets/hero-layers/bread-body.webp')} width="800" height="800" alt="" fetchpriority="high" decoding="async" />
          <img class="hero__bread-layer hero__bread-layer--score" src={withBase('assets/hero-layers/score-main.webp')} width="800" height="800" alt="" decoding="async" />
          <img class="hero__bread-layer hero__bread-layer--flour" src={withBase('assets/hero-layers/flour-surface.webp')} width="800" height="800" alt="" decoding="async" />
        </div>
        <img class="hero__bread-layer hero__bread-layer--dust" src={withBase('assets/hero-layers/flour-particles.webp')} width="800" height="800" alt="" aria-hidden="true" decoding="async" />
      </div>
      <span class="hero__visual-index" aria-hidden="true">FIG. 01 — LA MIGA</span>
      <div class="hero__product-label" aria-hidden="true">
        <span class="hero__product-number">NUESTRA SELECCIÓN / 01</span>
        <span class="hero__product-title">{featured.name}</span>
      </div>
    </div>
  </div>
</section>
<div class="ticker" aria-label="Nuestros valores">
  <div class="ticker__inner">
    <span>HARINA &amp; AGUA</span><i aria-hidden="true">✳</i>
    <span>TIEMPO &amp; PACIENCIA</span><i aria-hidden="true">✳</i>
    <span>PAN DE VERDAD</span><i aria-hidden="true">✳</i>
    <span>DESDE TETUÁN</span>
  </div>
</div>

<script>
  // One physical loaf built from registered real photo layers. Scroll drives its
  // lift, grounded shadow, score highlights, flour reveal and airborne particles.
  // No synthetic dough deformation, wheel capture, or WebGL.
  const hero = document.querySelector<HTMLElement>('.hero');
  const stage = document.querySelector<HTMLElement>('.hero__bread-stage');
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (hero && stage && !motionPreference.matches) {
    let raf = 0;
    const update = () => {
      raf = 0;
      // The hero starts below the header: measure from page scroll zero so the
      // scene visibly reacts to the first wheel/touch movement.
      const distance = Math.max(250, hero.offsetHeight * .52);
      const t = Math.max(0, Math.min(1, window.scrollY / distance));
      // 70px of visible lift on desktop; 46px on a phone, while shadow remains.
      const mobile = window.innerWidth <= 720;
      const lift = mobile ? 46 : 72;
      stage.style.setProperty('--bread-lift', `${-lift * t}px`);
      stage.style.setProperty('--bread-tilt', `${-2 + 9 * t}deg`);
      stage.style.setProperty('--bread-scale', String(1 + t * .075));
      stage.style.setProperty('--bread-shadow-opacity', String(.87 - t * .47));
      stage.style.setProperty('--bread-shadow-scale', String(1 - t * .19));
      stage.style.setProperty('--bread-score-opacity', String(.3 + t * .7));
      stage.style.setProperty('--bread-flour-opacity', String(.16 + t * .84));
      stage.style.setProperty('--bread-dust-opacity', String(.12 + t * .88));
      stage.style.setProperty('--bread-dust-x', `${-25 + t * 95}px`);
      stage.style.setProperty('--bread-dust-y', `${30 - t * 112}px`);
      stage.style.setProperty('--bread-dust-scale', String(.82 + t * .35));
    };
    const schedule = () => {
      if (raf) return;
      raf = window.requestAnimationFrame(update);
    };
    schedule();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('pageshow', schedule);
  }
</script>
