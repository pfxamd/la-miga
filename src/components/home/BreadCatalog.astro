---
import { products, categoryLabels } from '../../data/products';
import BreadCard from '../shop/BreadCard.astro';
---
<section class="products-section section" id="panes" aria-labelledby="catalog-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">EL CATÁLOGO · 06 VARIEDADES</span>
        <h2 id="catalog-title">Nuestros <em>panes.</em></h2>
      </div>
      <p>Seis formas de entender el pan. Encuentra el tuyo y prepara tu cesta.</p>
    </div>
    <div class="filters" role="group" aria-label="Filtrar tipos de pan">
      <button class="filter is-active" data-filter="todos" type="button" aria-pressed="true">Todos <span>{String(products.length).padStart(2,'0')}</span></button>
      {Object.entries(categoryLabels).map(([key, label]) =>
        <button class="filter" data-filter={key} type="button" aria-pressed="false">{label}</button>
      )}
    </div>
    <div class="product-grid">
      {products.map((product, index) => <BreadCard product={product} index={index} />)}
    </div>
    <p class="catalog-footnote">Precios de referencia · Disponibilidad a confirmar antes de la recogida.</p>
  </div>
</section>
<script>
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  filters.forEach((button) => button.addEventListener('click', () => {
    const chosen = button.dataset.filter ?? 'todos';
    filters.forEach((filter) => {
      const active = filter === button;
      filter.classList.toggle('is-active', active);
      filter.setAttribute('aria-pressed', String(active));
    });
    cards.forEach((card) => { card.hidden = chosen !== 'todos' && card.dataset.category !== chosen; });
  }));
</script>
