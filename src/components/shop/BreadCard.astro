---
import AddToCart from '../cart/AddToCart.astro';
import { siteBase, withBase, categoryLabels } from '../../data/products';
import type { BreadProduct } from '../../data/products';

interface Props { product: BreadProduct; index: number; }
const { product, index } = Astro.props;
const detail = `${siteBase}pan/${product.slug}/`;
const number = String(index + 1).padStart(2, '0');
const category = categoryLabels[product.category];
const lowerIngredients = product.ingredients.toLowerCase();
const lowerMethod = (product.method ?? '').toLowerCase();
const craftDetail = lowerIngredients.includes('masa madre')
  ? 'MASA MADRE'
  : lowerIngredients.includes('sésamo')
    ? 'SÉSAMO'
    : lowerMethod.includes('baja hidratación')
      ? 'MASA FIRME'
      : lowerMethod.includes('cocción breve')
        ? 'COCCIÓN SUAVE'
        : 'HORNEADO';
---
<article class="product-card" data-category={product.category}>
  <div class:list={['product-card__visual', `product-card__visual--${(index % 4) + 1}`]}>
    <svg class="product-card__etch" viewBox="0 0 180 140" fill="none" aria-hidden="true" focusable="false">
      <g stroke="currentColor" stroke-width=".9" stroke-linecap="round">
        <path d="M15 121C32 83 72 40 139 24" />
        <path d="M31 128C48 85 88 56 158 35" />
        <path d="M52 132C72 96 107 72 172 56" />
        <path d="M67 91l23 8M92 67l23 7M114 45l22 7" />
        <path d="M20 24h24M32 12v24" />
      </g>
      <circle cx="32" cy="24" r="16" stroke="currentColor" stroke-width=".7" />
    </svg>
    <span class="product-card__index">LM / {number}</span>
    <a href={detail} aria-label={`Ver ${product.name}`} class="product-card__image-link">
      <img src={withBase(product.image)} width="800" height="800" alt={product.name} loading="lazy" decoding="async" />
    </a>
    <span class="product-card__weight">{product.weightGrams} g</span>
  </div>

  <div class="product-card__info">
    <div class="product-card__imprint" aria-hidden="true">
      <span>LA MIGA</span>
      <svg viewBox="0 0 55 12" fill="none" focusable="false">
        <path d="M1 6h18M36 6h18M24 10l4-8 4 8M23 5l5 3 5-3" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{category}</span>
    </div>
    <div class="product-card__headline">
      <div class="product-card__title-wrap">
        <a href={detail} class="product-card__title">{product.name}</a>
        <svg class="product-card__underline" viewBox="0 0 174 11" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
          <path d="M2 6C39 1 87 4 125 5C145 6 157 4 171 2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
          <path d="M106 4l6 5M114 4l6 5M122 4l6 5" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
        </svg>
      </div>
      <strong class="product-card__seal" aria-label={`Precio: ${product.priceMAD} dirhams`}>
        <svg class="product-card__seal-ring" viewBox="0 0 100 100" fill="none" aria-hidden="true" focusable="false">
          <path d="M50 3C62 1 73 7 81 14C91 22 96 35 97 48C99 63 93 75 84 84C75 94 62 98 50 97C37 98 23 93 14 83C6 74 2 62 3 49C2 37 7 23 17 15C26 7 37 4 50 3Z" stroke="currentColor" stroke-width="1.2"/>
          <path d="M50 10C60 9 70 14 77 20C85 27 90 38 90 50C91 61 85 72 78 79C71 87 60 91 50 90C39 91 28 86 21 78C13 70 10 60 10 50C10 39 14 28 22 21C29 14 40 10 50 10Z" stroke="currentColor" stroke-width=".8" stroke-dasharray="2 5"/>
          <path d="M39 17l3 4M50 15v6M61 17l-3 4M39 84l3-4M50 85v-6M61 84l-3-4" stroke="currentColor" stroke-width=".9" stroke-linecap="round"/>
        </svg>
        <span class="product-card__seal-number">{product.priceMAD}</span>
        <span class="product-card__seal-currency">MAD</span>
      </strong>
    </div>
    <p class="product-card__description">{product.subtitle}</p>
    <div class="product-card__traits" aria-label="Datos del pan">
      <span>TRIGO</span>
      <span class="product-card__traits-separator" aria-hidden="true">✳</span>
      <span>{craftDetail}</span>
      <span class="product-card__traits-end" aria-hidden="true"></span>
    </div>
  </div>
  <div class="product-card__action">
    <AddToCart id={product.id} productName={product.name} title="A la cesta" available={product.available} artisan />
    <a href={detail} class="product-card__discover">
      <span>Ver detalles</span>
      <svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 15L15 4M7 4h8v8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</article>
