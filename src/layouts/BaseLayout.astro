---
import '../styles/global.css';
import CartDrawer from '../components/cart/CartDrawer';
import { siteBase } from '../data/products';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Pan de verdad, hecho con tiempo. LA MIGA, panadería artesanal en Tetuán.',
} = Astro.props;
const base = siteBase;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e9" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="announcement"><span>HECHO CON TIEMPO.</span> <span>HORNEADO CON CARIÑO.</span></div>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={base} aria-label="La Miga — Inicio"><img class="brand__img" src={`${base}assets/brand/la-miga-logo.webp`} alt="LA MIGA — Panadería Artesanal" width="220" height="71" /></a>
        <nav class="nav" aria-label="Navegación principal">
          <a href={`${base}#panes`}>Nuestros panes</a>
          <a href={`${base}#obrador`}>El obrador</a>
          <a href={`${base}#nosotros`}>Nosotros</a>
        </nav>
        <CartDrawer client:load />
      </div>
    </header>
    <slot />
    <footer class="footer" id="contacto">
      <div class="container">
        <div class="footer__top">
          <div><div class="footer__wordmark">LA MIGA<span>.</span></div><p>Pan hecho con tiempo. Compartido con ganas.</p></div>
          <div><span class="eyebrow">ENCUÉNTRANOS</span><p>Tetuán, Marruecos</p><small>Recogida previa confirmación.</small></div>
        </div>
        <div class="footer__bottom"><span>© {new Date().getFullYear()} LA MIGA</span><span>PANADERÍA ARTESANAL · TETUÁN</span></div>
        <div class="footer__credit">Diseño y desarrollo por <a href="https://pfxamd.com/" target="_blank" rel="noopener noreferrer" aria-label="PFXAMD — Diseño y desarrollo web">PFXAMD</a></div>
      </div>
    </footer>
  </body>
</html>
